{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flight_id",
    "dataset_version",
    "airline_code",
    "flight_number",
    "aircraft_id",
    "origin",
    "destination",
    "departure_time_local",
    "arrival_time_local",
    "departure_time_utc",
    "arrival_time_utc",
    "duration_minutes",
    "selling_status",
    "operational_status",
    "baggage_rule_id",
    "economy_inventory",
    "premium_economy_inventory",
    "business_inventory",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "flight_id": { "type": "string", "minLength": 6 },
    "dataset_version": { "type": "string" },
    "airline_code": { "type": "string", "minLength": 2, "maxLength": 4 },
    "flight_number": { "type": "string", "pattern": "^[A-Z]{2}[0-9]{2,4}$" },
    "aircraft_id": { "type": "string" },
    "origin": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "destination": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "departure_time_local": { "type": "string", "format": "date-time" },
    "arrival_time_local": { "type": "string", "format": "date-time" },
    "departure_time_utc": { "type": "string", "format": "date-time" },
    "arrival_time_utc": { "type": "string", "format": "date-time" },
    "duration_minutes": { "type": "integer", "minimum": 1 },
    "selling_status": {
      "type": "string",
      "enum": ["OPEN", "LIMITED", "CLOSED", "WAITLIST"]
    },
    "operational_status": {
      "type": "string",
      "enum": ["SCHEDULED", "BOARDING", "DEPARTED", "ARRIVED", "DELAYED", "CANCELLED"]
    },
    "baggage_rule_id": { "type": "string" },
    "economy_inventory": { "type": "integer", "minimum": 0 },
    "premium_economy_inventory": { "type": "integer", "minimum": 0 },
    "business_inventory": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
